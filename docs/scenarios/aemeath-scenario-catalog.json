{
  "schema_version": "1.0",
  "catalog_id": "aemeath-interaction-scenarios",
  "persona_name": "爱弥斯",
  "purpose": "列出当前已经确认的普通与特殊互动场景，方便后续开发查阅和追加场景。",
  "runtime_usage": "DOCUMENTATION_ONLY",
  "maintenance_guide": [
    "新增场景时复制一个现有条目并更换稳定 ID，不要复用或重命名已经发布的 ID。",
    "when 描述判定证据，example_inputs 只帮助理解，不应被实现成关键词触发表。",
    "expected_behavior 记录可验收结果，must_not 记录最容易发生的错误行为。",
    "尚未确认的设想不要混入本目录；确认后再以 CONFIRMED 状态追加。"
  ],
  "category_definitions": {
    "ordinary": "由常规闲聊主链处理的日常互动。",
    "special": "需要额外的关系、安全、命令、媒体、状态、复读或降级边界的互动。"
  },
  "field_guide": {
    "id": "稳定且不可复用的场景 ID。",
    "family": "便于浏览的场景分组。",
    "when": "判断该场景成立时需要观察的条件。",
    "example_inputs": "只提供输入示例，不是触发词表。",
    "relationship_effect": "关系系统允许改变的处理方式；为空表示关系不应改变主结果。",
    "expected_route": "该场景应进入的主要处理链。",
    "expected_moves": "已经确定的社交动作；非闲聊路由可以为空。",
    "expected_behavior": "必须实现的行为结果，不规定固定回复文本。",
    "must_not": "该场景明确禁止的处理。",
    "basis": "REFERENCE_DATA、PRODUCT_DECISION、SAFETY_RULE 或 PLUGIN_INTEGRATION。",
    "design_status": "当前是否已经完成产品确认。"
  },
  "source_documents": [
    "analysis/target_bot_20260826_style_system_analysis.md",
    "docs/superpowers/specs/2026-08-27-aemeath-smalltalk-style-system-design.md",
    "docs/superpowers/plans/2026-08-27-aemeath-smalltalk-style-core.md",
    "docs/superpowers/plans/2026-08-27-aemeath-command-capability-routing.md",
    "docs/superpowers/plans/2026-08-27-aemeath-media-public-state.md"
  ],
