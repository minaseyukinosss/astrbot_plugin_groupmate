{
  "scope_group": {
    "description": "启用范围",
    "type": "object",
    "hint": "只决定插件在哪些 QQ 群工作。",
    "items": {
      "enabled_groups": {
        "description": "启用群列表",
        "type": "list",
        "default": [],
        "hint": "填写 QQ 群号；留空表示所有群。"
      }
    }
  },
  "persona_group": {
    "description": "人格部署配置",
    "type": "object",
    "hint": "称呼和初始关系按人格隔离；切换人格时不会混用。",
    "items": {
      "persona_aliases": {
        "description": "分人格称呼配置",
        "type": "object",
        "hint": "这些称呼用于判断群友是否在叫当前人格；允许配置为空，不会自动补回默认值。",
        "items": {
          "aemeath": {
            "description": "爱弥斯的称呼",
            "type": "list",
            "default": ["爱弥斯", "小爱", "飞行雪绒"]
          }
        }
      },
      "relationships": {
        "description": "分人格初始关系配置",
        "type": "object",
        "hint": "只为尚无状态的群友设置初始关系；不会覆盖已有好感度和关系状态。",
        "items": {
          "aemeath": {
            "description": "爱弥斯的初始关系",
            "type": "template_list",
            "default": [],
            "templates": {
              "member": {
                "name": "群成员",
                "display_item": "id",
                "hide_hint_in_list": true,
                "items": {
                  "id": {
                    "description": "QQ 号",
                    "type": "string",
                    "default": ""
                  },
                  "relationship": {
                    "description": "初始关系",
                    "type": "string",
                    "default": "普通群友",
                    "options": ["普通群友", "闺蜜", "最亲近"]
                  },
                  "address": {
                    "description": "建议称呼",
                    "type": "string",
                    "default": "",
                    "hint": "留空时使用对方当前群昵称。"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "relationship_learning_group": {
    "description": "关系学习灰度",
    "type": "object",
    "hint": "新关系证据默认只进入影子复核，不改变爱弥斯对人的长期判断。只有达到质量门槛且在此放行的群，后续证据才自动生效。",
    "items": {
      "active_groups": {
        "description": "允许自动生效的群",
        "type": "list",
        "default": [],
        "hint": "填写 QQ 群号。留空表示所有群都保持影子学习；页面复核仍可逐条生效。"
      },
      "min_reviewed_samples": {
        "description": "最少复核样本",
        "type": "int",
        "default": 20,
        "hint": "单群至少完成多少条人工复核后，才允许判断是否达到自动生效门槛。范围 5~200。"
      },
      "max_error_rate": {
        "description": "最高误判率",
        "type": "float",
        "default": 0.1,
        "hint": "认错人、类型判断错、上下文不足都计入误判。0.1 表示不高于 10%。"
      }
    }
  },
  "provider_group": {
    "description": "模型配置",
    "type": "object",
    "hint": "显式选择的模型优先；留空时跟随当前群聊模型。",
    "items": {
      "generation_provider": {
        "description": "文本生成模型",
        "type": "string",
        "_special": "select_provider",
        "default": "",
        "hint": "留空时使用当前群聊天模型；显式模型不可用时不会静默切换。"
      },
      "vision_enabled": {
        "description": "图片理解开关",
        "type": "bool",
        "default": true
      },
      "vision_provider": {
        "description": "图片理解模型",
        "type": "string",
        "_special": "select_provider",
        "default": "",
        "hint": "留空时复用实际使用的文本生成模型；不可用时跳过图片理解并继续文本处理。"
      }
    }
  },
  "tools_group": {
    "description": "自然语言工具",
    "type": "object",
    "hint": "由 Groupmate 自己发现、选择并调用 AstrBot 已注册工具；权限始终使用真实用户身份。",
    "items": {
      "enabled": {
        "description": "启用自然语言工具调用",
        "type": "bool",
        "default": true,
        "hint": "开启后，仅在用户明确呼叫当前人格并提出工具请求时尝试执行。"
      },
      "command_bridge_enabled": {
        "description": "兼容只有命令的插件",
        "type": "bool",
        "default": true,
        "hint": "允许发现并受控调用其他插件的 command handler；关闭后只使用原生 llm_tool。"
      },
      "candidate_limit": {
        "description": "候选工具数量",
        "type": "int",
        "default": 8,
        "hint": "每次最多交给路由模型的候选数，范围 1~20。"
      }
    }
  },
  "mail_group": {
    "description": "QQ 邮件",
    "type": "object",
    "hint": "内置发信能力。默认关闭；需填写发件 QQ 邮箱与授权码后才会出现在工具候选中。",
    "items": {
      "enabled": {
        "description": "启用 QQ 邮件",
        "type": "bool",
        "default": false,
        "hint": "关闭时不会提供发信工具。开启后仍需配置发件邮箱与授权码。"
      },
      "smtp_host": {
        "description": "SMTP 主机",
        "type": "string",
        "default": "smtp.qq.com"
      },
      "smtp_port": {
        "description": "SMTP 端口",
        "type": "int",
        "default": 465,
        "hint": "推荐 465（SSL）；也可 587（STARTTLS，需关闭 use_ssl）。"
      },
      "use_ssl": {
        "description": "使用 SSL 直连",
        "type": "bool",
        "default": true,
        "hint": "465 端口保持开启；改用 587 时请关闭并依赖 STARTTLS。"
      },
      "from_address": {
        "description": "发件 QQ 邮箱",
        "type": "string",
        "default": "",
        "hint": "例如 123456789@qq.com"
      },
      "auth_code": {
        "description": "SMTP 授权码",
        "type": "string",
        "default": "",
        "hint": "QQ 邮箱网页生成的 16 位授权码，不是登录密码。"
      },
      "from_display_name": {
        "description": "发件显示名",
        "type": "string",
        "default": "",
        "hint": "留空则使用当前启用人格的显示名；人格切换后自动跟随。"
      },
      "unauthorized_mode": {
        "description": "越权处理",
        "type": "string",
        "default": "random",
        "options": ["tease_reply", "tease_mail", "random"],
        "hint": "普通成员指定他人时：群内调侃 / 给请求者寄调侃信 / 随机。仅 AstrBot 管理员或 QQ 群主可指定他人；普通群管不算。"
      },
      "daily_limit_per_user": {
        "description": "每用户每日限额",
        "type": "int",
        "default": 5,
        "hint": "0 表示不限制日次数。"
      },
      "send_interval_seconds": {
        "description": "发送最短间隔（秒）",
        "type": "int",
        "default": 60,
        "hint": "同一用户两次发信最短间隔；0 表示不限制。"
      },
      "dry_run": {
        "description": "演练模式",
        "type": "bool",
        "default": false,
        "hint": "走完整链路但不真实 SMTP，便于联调。"
      }
    }
  },
  "fun_group": {
    "description": "趣味小功能",
    "type": "object",
    "hint": "可选、低频的小功能；默认关闭，不参与核心回复、关系或长期记忆。",
    "items": {
      "enabled": {
        "description": "启用趣味小功能",
        "type": "bool",
        "default": false
      },
      "enabled_groups": {
        "description": "启用群列表",
        "type": "list",
        "default": [],
        "hint": "填写 QQ 群号；留空表示跟随 Groupmate 已观察到的启用群。"
      },
      "dynamic_card": {
        "description": "动态群名片",
        "type": "object",
        "hint": "把 Bot 自己的群名片做成爱弥斯在星炬学院的低频生活状态牌，并保留短期来源供后续追问。",
        "items": {
          "enabled": {
            "description": "启用动态群名片",
            "type": "bool",
            "default": false
          },
          "base_name": {
            "description": "基础名称",
            "type": "string",
            "default": "爱弥斯"
          },
          "separator": {
            "description": "分隔符",
            "type": "string",
            "default": "丨"
          },
          "min_interval_minutes": {
            "description": "最短刷新间隔（分钟）",
            "type": "int",
            "default": 90,
            "hint": "范围 30~1440。动态名片是低频状态牌，不建议过短。"
          },
          "max_interval_minutes": {
            "description": "最长刷新间隔（分钟）",
            "type": "int",
            "default": 180
          }
        }
      }
    }
  },
  "interaction_group": {
    "description": "宿主互动",
    "type": "object",
    "hint": "戳一戳默认关闭。下方高级项可覆盖内置概率/冷却；留空或非法值回退默认。",
    "items": {
      "poke_enabled": {
        "description": "戳一戳互动",
        "type": "bool",
        "default": false,
        "hint": "开启后由 Groupmate 回复戳 Bot 事件，并可观察他人互戳以跟风。"
      },
      "poke_back_enabled": {
        "description": "允许回戳 / 跟风戳",
        "type": "bool",
        "default": false,
        "hint": "开启后可对戳你的人或互戳目标发送平台戳一戳；关闭时只可能文字回应。"
      },
      "poke_exclusive": {
        "description": "独占戳事件",
        "type": "bool",
        "default": false,
        "hint": "开启后对已接管的戳事件调用 stop_event，避免与其他戳插件双响。默认关闭以保持旁路兼容。"
      },
      "poke_face_enabled": {
        "description": "被戳偶发 QQ 表情",
        "type": "bool",
        "default": false,
        "hint": "仅发送少量系统表情（Face），不走表情包图库。"
      },
      "poke_react_probability": {
        "description": "被戳回应概率",
        "type": "float",
        "default": 0.88,
        "hint": "高级：0~1，默认 0.88。"
      },
      "poke_cooldown_seconds": {
        "description": "被戳冷却（秒）",
        "type": "int",
        "default": 8,
        "hint": "高级：同人冷却，默认 8。"
      },
      "poke_back_probability": {
        "description": "回戳动作概率",
        "type": "float",
        "default": 0.35,
        "hint": "高级：被戳回应中含出站戳的概率，默认 0.35。"
      },
      "poke_bystander_probability": {
        "description": "跟戳基础概率",
        "type": "float",
        "default": 0.33,
        "hint": "高级：他人互戳时跟风基础概率（再按好感缩放），默认 0.33。"
      },
      "poke_bystander_cooldown_seconds": {
        "description": "跟戳冷却（秒）",
        "type": "int",
        "default": 20,
        "hint": "高级：同群跟风冷却，默认 20。"
      },
      "poke_face_probability": {
        "description": "表情触发概率",
        "type": "float",
        "default": 0.12,
        "hint": "高级：开启「偶发 QQ 表情」后的触发概率，默认 0.12。"
      }
    }
  }
}
