{
  "scope_group": {
    "description": "启用范围",
    "type": "object",
    "hint": "只决定插件在哪些 QQ 群工作。",
    "items": {
      "enabled_groups": {
        "description": "启用群列表",
        "type": "list",
        "default": [],
        "hint": "填写 QQ 群号；留空表示所有群。"
      }
    }
  },
  "persona_group": {
    "description": "人格部署配置",
    "type": "object",
    "hint": "称呼和初始关系按人格隔离；切换人格时不会混用。",
    "items": {
      "persona_aliases": {
        "description": "分人格称呼配置",
        "type": "object",
        "hint": "这些称呼用于判断群友是否在叫当前人格；允许配置为空，不会自动补回默认值。",
        "items": {
          "aemeath": {
            "description": "爱弥斯的称呼",
            "type": "list",
            "default": ["爱弥斯", "小爱", "飞行雪绒"]
          }
        }
      },
      "relationships": {
        "description": "分人格初始关系配置",
        "type": "object",
        "hint": "只为尚无状态的群友设置初始关系；不会覆盖已有好感度和关系状态。",
        "items": {
          "aemeath": {
            "description": "爱弥斯的初始关系",
            "type": "template_list",
            "default": [],
            "templates": {
              "member": {
                "name": "群成员",
                "display_item": "id",
                "hide_hint_in_list": true,
                "items": {
                  "id": {
                    "description": "QQ 号",
                    "type": "string",
                    "default": ""
                  },
                  "relationship": {
                    "description": "初始关系",
                    "type": "string",
                    "default": "普通群友",
                    "options": ["普通群友", "闺蜜", "最亲近"]
                  },
                  "address": {
                    "description": "建议称呼",
                    "type": "string",
                    "default": "",
                    "hint": "留空时使用对方当前群昵称。"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "provider_group": {
    "description": "模型配置",
    "type": "object",
    "hint": "显式选择的模型优先；留空时跟随当前群聊模型。",
    "items": {
      "generation_provider": {
        "description": "文本生成模型",
        "type": "string",
        "_special": "select_provider",
        "default": "",
        "hint": "留空时使用当前群聊天模型；显式模型不可用时不会静默切换。"
      },
      "vision_enabled": {
        "description": "图片理解开关",
        "type": "bool",
        "default": true
      },
      "vision_provider": {
        "description": "图片理解模型",
        "type": "string",
        "_special": "select_provider",
        "default": "",
        "hint": "留空时复用实际使用的文本生成模型；不可用时跳过图片理解并继续文本处理。"
      }
    }
  }
}
