    "default": []
  },
  "generation_provider": {
    "description": "文本生成模型",
    "type": "string",
    "_special": "select_provider",
    "default": ""
  },
  "vision_provider": {
    "description": "图片理解模型",
    "type": "string",
    "_special": "select_provider",
    "default": ""
  },
  "persona_id": {
    "description": "人格标识",
    "type": "string",
    "default": "aemeath"
