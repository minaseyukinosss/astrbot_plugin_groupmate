{
  "scope_group": {
    "description": "启用范围",
    "type": "object",
    "hint": "只决定插件在哪些 QQ 群工作。",
    "items": {
      "enabled_groups": {
        "description": "启用群列表",
        "type": "list",
        "default": [],
        "hint": "填写 QQ 群号；留空表示所有群。"
      }
    }
  },
  "persona_group": {
    "description": "人格部署配置",
    "type": "object",
    "hint": "称呼和初始关系按人格隔离；切换人格时不会混用。",
    "items": {
      "persona_aliases": {
        "description": "分人格称呼配置",
        "type": "object",
        "hint": "这些称呼用于判断群友是否在叫当前人格；允许配置为空，不会自动补回默认值。",
        "items": {
          "aemeath": {
            "description": "爱弥斯的称呼",
            "type": "list",
            "default": ["爱弥斯", "小爱", "飞行雪绒"]
          }
        }
      },
      "relationships": {
        "description": "分人格初始关系配置",
        "type": "object",
        "hint": "只为尚无状态的群友设置初始关系；不会覆盖已有好感度和关系状态。",
        "items": {
          "aemeath": {
            "description": "爱弥斯的初始关系",
            "type": "template_list",
            "default": [],
            "templates": {
              "member": {
                "name": "群成员",
                "display_item": "id",
                "hide_hint_in_list": true,
                "items": {
                  "id": {
                    "description": "QQ 号",
                    "type": "string",
                    "default": ""
                  },
                  "relationship": {
                    "description": "初始关系",
                    "type": "string",
                    "default": "普通群友",
                    "options": ["普通群友", "闺蜜", "最亲近"]
                  },
                  "address": {
                    "description": "建议称呼",
                    "type": "string",
                    "default": "",
                    "hint": "留空时使用对方当前群昵称。"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "provider_group": {
    "description": "模型配置",
    "type": "object",
    "hint": "显式选择的模型优先；留空时跟随当前群聊模型。",
    "items": {
      "generation_provider": {
        "description": "文本生成模型",
        "type": "string",
        "_special": "select_provider",
        "default": "",
        "hint": "留空时使用当前群聊天模型；显式模型不可用时不会静默切换。"
      },
      "vision_enabled": {
        "description": "图片理解开关",
        "type": "bool",
        "default": true
      },
      "vision_provider": {
        "description": "图片理解模型",
        "type": "string",
        "_special": "select_provider",
        "default": "",
        "hint": "留空时复用实际使用的文本生成模型；不可用时跳过图片理解并继续文本处理。"
      }
    }
  },
  "interaction_group": {
    "description": "宿主互动",
    "type": "object",
    "hint": "戳一戳默认关闭。下方高级项可覆盖内置概率/冷却；留空或非法值回退默认。",
    "items": {
      "poke_enabled": {
        "description": "戳一戳互动",
        "type": "bool",
        "default": false,
        "hint": "开启后由 Groupmate 回复戳 Bot 事件，并可观察他人互戳以跟风。"
      },
      "poke_back_enabled": {
        "description": "允许回戳 / 跟风戳",
        "type": "bool",
        "default": false,
        "hint": "开启后可对戳你的人或互戳目标发送平台戳一戳；关闭时只可能文字回应。"
      },
      "poke_exclusive": {
        "description": "独占戳事件",
        "type": "bool",
        "default": false,
        "hint": "开启后对已接管的戳事件调用 stop_event，避免与其他戳插件双响。默认关闭以保持旁路兼容。"
      },
      "poke_face_enabled": {
        "description": "被戳偶发 QQ 表情",
        "type": "bool",
        "default": false,
        "hint": "仅发送少量系统表情（Face），不走表情包图库。"
      },
      "poke_react_probability": {
        "description": "被戳回应概率",
        "type": "float",
        "default": 0.88,
        "hint": "高级：0~1，默认 0.88。"
      },
      "poke_cooldown_seconds": {
        "description": "被戳冷却（秒）",
        "type": "int",
        "default": 8,
        "hint": "高级：同人冷却，默认 8。"
      },
      "poke_back_probability": {
        "description": "回戳动作概率",
        "type": "float",
        "default": 0.35,
        "hint": "高级：被戳回应中含出站戳的概率，默认 0.35。"
      },
      "poke_bystander_probability": {
        "description": "跟戳基础概率",
        "type": "float",
        "default": 0.33,
        "hint": "高级：他人互戳时跟风基础概率（再按好感缩放），默认 0.33。"
      },
      "poke_bystander_cooldown_seconds": {
        "description": "跟戳冷却（秒）",
        "type": "int",
        "default": 20,
        "hint": "高级：同群跟风冷却，默认 20。"
      },
      "poke_face_probability": {
        "description": "表情触发概率",
        "type": "float",
        "default": 0.12,
        "hint": "高级：开启「偶发 QQ 表情」后的触发概率，默认 0.12。"
      }
    }
  }
}
